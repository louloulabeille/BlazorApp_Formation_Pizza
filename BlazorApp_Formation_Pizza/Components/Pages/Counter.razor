@page "/counter/{InitCount:int}"
@page "/counter/{InitCount:int}/{Name}"

@inherits CounterBase

@rendermode InteractiveServer



<!--<h3>Counter</h3>-->
<div>
    <img src="favicon.png" />
</div>


<div>
    <label>Current count: @CurrentCount</label>
</div>
<div>
    <!-- on désactive le bouton si le compteur atteint 20 -->
    <button class="btn btn-primary" 
            disabled="@(CurrentCount>=20)" 
            @onclick="IncrementCount">Click me</button>
            <!-- @onclick="()=>CurrentCount++" -->
    <button class="btn btn-secondary" 
            disabled="@(CurrentCount >= 20)"
            onclick="IncrementBy3()">
        
        Increment by 3
    </button>
</div>

<div>
    <label>Name: @Name</label>
</div>

